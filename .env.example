APP_NAME="ささいずみ Web予約"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
# 本番（ALB で HTTPS 終端）では * を指定する
TRUSTED_PROXIES=
APP_PORT=8090

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP
APP_TIMEZONE=Asia/Tokyo

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 既存 POS（予約台帳）。開発時はホストで SSH トンネルを張る（README 参照）
DB_CONNECTION=pos
POS_DB_HOST=host.docker.internal
POS_DB_PORT=3307
POS_DB_DATABASE=dev_erp
POS_DB_USERNAME=
POS_DB_PASSWORD=

# 予約サイト独自のテーブルは持たないため、セッション・キャッシュはファイルで管理する
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# 季節商品予約の受付期間（未設定の場合は config/seasonal/*.php の値）
# SEASONAL_XMAS_2026_OPENS_AT="2026-11-21 00:00:00"
# SEASONAL_XMAS_2026_CLOSES_AT="2026-12-21 23:59:59"
